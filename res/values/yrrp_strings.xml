<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- YRRPs settings page title. [CHAR LIMIT=30] -->
    <string name="yrrp_settings_title" translatable="false">YRRPs</string>
    <!-- Summary of the YRRPs settings entry. [CHAR LIMIT=NONE] -->
    <string name="yrrp_settings_summary">Pulse visualizer, screen-off animation</string>
    <!-- YRRPs settings: two-pane highlight key for the YRRPs homepage tile; must equal the tile key. -->
    <string name="yrrp_menu_key" translatable="false">top_level_yrrp</string>

    <!-- YRRPs settings: category heading for audio features on the YRRPs page. [CHAR LIMIT=40] -->
    <string name="yrrp_category_audio">Audio</string>
    <!-- YRRPs settings: category heading for animation features on the YRRPs page. [CHAR LIMIT=40] -->
    <string name="yrrp_category_animations">Animations</string>

    <!-- YRRPs settings: Pulse row on the YRRPs page and title of the Pulse page. Both must stay
         this one string: SettingsIntelligence's site-map lookup matches on class name plus title.
         [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_title">Pulse</string>
    <!-- YRRPs settings: search keywords for Pulse. [CHAR_LIMIT=NONE] -->
    <string name="yrrp_pulse_keywords">audio, visualizer, music, spectrum, navigation bar, opacity, transparency, color mode, theme, dark theme</string>
    <!-- YRRPs settings: intro text at the top of the Pulse page. [CHAR LIMIT=NONE] -->
    <string name="yrrp_pulse_intro">Show a spectrum of playing audio in the navigation bar</string>
    <!-- YRRPs settings: Pulse page main switch title. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_main_switch_title">Use Pulse</string>
    <!-- YRRPs settings: Pulse color picker dialog title, also the description of the gear on the Solid color mode row. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_color_title">Pulse color</string>
    <!-- YRRPs settings: label of the red channel slider in the Pulse color picker. [CHAR LIMIT=20] -->
    <string name="yrrp_pulse_color_red">Red</string>
    <!-- YRRPs settings: label of the green channel slider in the Pulse color picker. [CHAR LIMIT=20] -->
    <string name="yrrp_pulse_color_green">Green</string>
    <!-- YRRPs settings: label of the blue channel slider in the Pulse color picker. [CHAR LIMIT=20] -->
    <string name="yrrp_pulse_color_blue">Blue</string>
    <!-- YRRPs settings: spoken value (0-255) of a color channel slider, e.g. "128"; the slider label names the channel. [CHAR LIMIT=NONE] -->
    <string name="yrrp_pulse_color_channel_state"><xliff:g id="value" example="128">%1$d</xliff:g></string>
    <!-- YRRPs settings: spoken description of the picked color as #RRGGBB, e.g. "Selected color #80FF00". [CHAR LIMIT=NONE] -->
    <string name="yrrp_pulse_color_hex_description">Selected color <xliff:g id="hex" example="#80FF00">%1$s</xliff:g></string>
    <!-- YRRPs settings: Pulse color mode category title on the Pulse page. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_color_mode_title">Color mode</string>
    <!-- YRRPs settings: Pulse color mode that draws the chosen Pulse color. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_color_mode_solid">Solid</string>
    <!-- YRRPs settings: Pulse color mode that follows the system dark theme. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_color_mode_match_theme">Match theme</string>
    <!-- YRRPs settings: summary of the Match theme Pulse color mode. [CHAR LIMIT=NONE] -->
    <string name="yrrp_pulse_color_mode_match_theme_summary">White bars with dark theme, black bars with light theme</string>
    <!-- YRRPs settings: Pulse color mode giving each bar its own slowly shifting hue. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_color_mode_rainbow_gradient">Rainbow gradient</string>
    <!-- YRRPs settings: summary of the Rainbow gradient Pulse color mode. [CHAR LIMIT=NONE] -->
    <string name="yrrp_pulse_color_mode_rainbow_gradient_summary">Each bar a different color, slowly shifting</string>
    <!-- YRRPs settings: Pulse color mode cycling all bars through the hues together. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_color_mode_rainbow_cycle">Rainbow cycle</string>
    <!-- YRRPs settings: summary of the Rainbow cycle Pulse color mode. [CHAR LIMIT=NONE] -->
    <string name="yrrp_pulse_color_mode_rainbow_cycle_summary">All bars share one color that cycles through the rainbow</string>
    <!-- YRRPs settings: search keywords for the Pulse color mode rows. [CHAR_LIMIT=NONE] -->
    <string name="yrrp_pulse_color_mode_keywords">Pulse color mode, theme, dark theme, light theme, black, white, rainbow, gradient, cycle, animated</string>
    <!-- YRRPs settings: search keywords for the Solid Pulse color mode row, whose gear opens the Pulse color picker. [CHAR_LIMIT=NONE] -->
    <string name="yrrp_pulse_solid_keywords">Pulse color, color picker, RGB, hex, solid, Pulse color mode</string>
    <!-- YRRPs settings: Pulse page category header above the opacity, height, bar and boost sliders, which apply in every color mode. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_appearance_title">Appearance</string>
    <!-- YRRPs settings: Pulse opacity slider title. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_opacity_title">Pulse opacity</string>
    <!-- YRRPs settings: search keywords for the Pulse opacity slider. [CHAR_LIMIT=NONE] -->
    <string name="yrrp_pulse_opacity_keywords">Pulse, opacity, transparency, alpha</string>
    <!-- YRRPs settings: Pulse height slider title. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_height_title">Pulse height</string>
    <!-- YRRPs settings: Pulse height value, e.g. "48 dp". [CHAR LIMIT=20] -->
    <string name="yrrp_pulse_height_value"><xliff:g id="height" example="48">%d</xliff:g> dp</string>
    <!-- YRRPs settings: Pulse bar count slider title. Sets how many spectrum bars span the screen width. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_bar_count_title">Bar count</string>
    <!-- YRRPs settings: Pulse bar count value, e.g. "32 bars". [CHAR LIMIT=20] -->
    <string name="yrrp_pulse_bar_count_value"><xliff:g id="count" example="32">%d</xliff:g> bars</string>
    <!-- YRRPs settings: search keywords for the Pulse bar count slider. [CHAR_LIMIT=NONE] -->
    <string name="yrrp_pulse_bar_count_keywords">Pulse, bars, count, number, density</string>
    <!-- YRRPs settings: Pulse bar gap slider title. Sets the space between neighbouring spectrum bars. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_bar_gap_title">Bar gap</string>
    <!-- YRRPs settings: search keywords for the Pulse bar gap slider. [CHAR_LIMIT=NONE] -->
    <string name="yrrp_pulse_bar_gap_keywords">Pulse, bars, gap, spacing, width</string>
    <!-- YRRPs settings: Pulse low-level boost slider title. Raises quiet spectrum bars through a logarithmic height curve. [CHAR LIMIT=40] -->
    <string name="yrrp_pulse_boost_title">Low-level boost</string>
    <!-- YRRPs settings: Pulse low-level boost value from 1 to 100, e.g. "20". [CHAR LIMIT=20] -->
    <string name="yrrp_pulse_boost_value"><xliff:g id="boost" example="20">%d</xliff:g></string>
    <!-- YRRPs settings: Pulse low-level boost value at 0, where bar heights stay linear. [CHAR LIMIT=20] -->
    <string name="yrrp_pulse_boost_off">Off</string>
    <!-- YRRPs settings: Pulse low-level boost row summary. Explains the effect, then shows the current value ("20" or "Off"). [CHAR LIMIT=60] -->
    <string name="yrrp_pulse_boost_summary">Makes quiet sounds move the bars more · <xliff:g id="value" example="20">%1$s</xliff:g></string>
    <!-- YRRPs settings: label at the start of the Pulse low-level boost slider, where bar heights follow loudness linearly. [CHAR LIMIT=12] -->
    <string name="yrrp_pulse_boost_linear">Linear</string>
    <!-- YRRPs settings: label at the end of the Pulse low-level boost slider, where quiet bars are lifted most. [CHAR LIMIT=12] -->
    <string name="yrrp_pulse_boost_lifted">Lifted</string>
    <!-- YRRPs settings: search keywords for the Pulse low-level boost slider. [CHAR_LIMIT=NONE] -->
    <string name="yrrp_pulse_boost_keywords">pulse, quiet, logarithmic, curve, bars, linear, lifted</string>
    <!-- YRRPs settings: Pulse privacy footer. [CHAR LIMIT=NONE] -->
    <string name="yrrp_pulse_privacy">Pulse processes the local playback spectrum in memory. It does not store or transmit audio.</string>

    <!-- YRRPs settings: screen-off animation row on the YRRPs page and title of the screen-off
         animation page. Both must stay this one string: SettingsIntelligence's site-map lookup
         matches on class name plus title. [CHAR LIMIT=40] -->
    <string name="yrrp_screen_off_animation_title">Screen-off animation</string>
    <!-- YRRPs settings: search keywords for the screen-off animation. [CHAR LIMIT=NONE] -->
    <string name="yrrp_screen_off_animation_keywords">CRT, glitch, screen off, power off animation</string>
    <!-- YRRPs settings: stock screen-off animation choice and row summary. [CHAR LIMIT=30] -->
    <string name="yrrp_screen_off_animation_stock">Stock</string>
    <!-- YRRPs settings: CRT screen-off animation choice and row summary. [CHAR LIMIT=30] -->
    <string name="yrrp_screen_off_animation_crt">CRT</string>
    <!-- YRRPs settings: Tear glitch screen-off animation choice and row summary. [CHAR LIMIT=30] -->
    <string name="yrrp_screen_off_animation_tear">Tear</string>
    <!-- YRRPs settings: Corrupt glitch screen-off animation choice and row summary. [CHAR LIMIT=30] -->
    <string name="yrrp_screen_off_animation_corrupt">Corrupt</string>
    <!-- YRRPs settings: Signal loss glitch screen-off animation choice and row summary. [CHAR LIMIT=30] -->
    <string name="yrrp_screen_off_animation_signal_loss">Signal loss</string>
    <!-- YRRPs settings: heading for the screen-off animation speed choices. [CHAR LIMIT=30] -->
    <string name="yrrp_screen_off_animation_speed_title">Speed</string>
    <!-- YRRPs settings: screen-off speed choice, half of normal speed. [CHAR LIMIT=10] -->
    <string name="yrrp_screen_off_animation_speed_50">0.5×</string>
    <!-- YRRPs settings: screen-off speed choice, three quarters of normal speed. [CHAR LIMIT=10] -->
    <string name="yrrp_screen_off_animation_speed_75">0.75×</string>
    <!-- YRRPs settings: screen-off speed choice, normal speed. [CHAR LIMIT=10] -->
    <string name="yrrp_screen_off_animation_speed_100">1×</string>
    <!-- YRRPs settings: screen-off speed choice, one and a half times normal speed. [CHAR LIMIT=10] -->
    <string name="yrrp_screen_off_animation_speed_150">1.5×</string>
    <!-- YRRPs settings: screen-off speed choice, twice normal speed. [CHAR LIMIT=10] -->
    <string name="yrrp_screen_off_animation_speed_200">2×</string>
</resources>
