<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/wifi_hotspot_checkbox_text">

    <com.android.settings.wifi.tether.WifiTetherSsidPreference
        android:key="wifi_tether_network_name"
        android:title="@string/wifi_hotspot_name_title"
        android:summary="@string/summary_placeholder"/>

    <ListPreference
        android:key="wifi_tether_security"
        android:title="@string/wifi_security"
        android:summary="@string/summary_placeholder"
        android:entries="@array/wifi_tether_security"
        android:entryValues="@array/wifi_tether_security_values"/>

    <Preference
        android:key="wifi_hotspot_security"
        android:title="@string/wifi_security"
        android:summary="@string/summary_placeholder"
        android:fragment="com.android.settings.wifi.tether.WifiHotspotSecuritySettings"
        settings:isPreferenceVisible="@bool/config_show_wifi_hotspot_speed"/>

    <com.android.settings.widget.ValidatedEditTextPreference
        android:key="wifi_tether_network_password"
        android:persistent="false"
        android:title="@string/wifi_hotspot_password_title"/>

    <SwitchPreferenceCompat
        android:key="wifi_tether_auto_turn_off"
        android:title="@string/wifi_hotspot_auto_off_title"
        android:summary="@string/wifi_hotspot_auto_off_summary"/>

    <SwitchPreferenceCompat
        android:key="wifi_tether_maximize_compatibility"
        android:title="@string/wifi_hotspot_maximize_compatibility"/>

    <Preference
        android:key="wifi_hotspot_speed"
        android:title="@string/wifi_hotspot_speed_title"
        android:summary="@string/summary_placeholder"
        android:fragment="com.android.settings.wifi.tether.WifiHotspotSpeedSettings"
        settings:isPreferenceVisible="@bool/config_show_wifi_hotspot_speed"/>

    <Preference
        android:key="wifi_hotspot_instant"
        android:title="@string/wifi_hotspot_instant_title"
        android:summary="@string/summary_placeholder"
        settings:isPreferenceVisible="false"/>

    <!-- YRRPs: connected clients, client limit, and blocked clients (YRRPs/project#74). -->
    <PreferenceCategory
        android:key="yrrp_hotspot_clients"
        android:title="@string/yrrp_hotspot_clients_title"
        settings:searchable="false"
        settings:controller="com.android.settings.yrrp.YrrpHotspotClientsPreferenceController"/>

    <!-- Its own titled group, so the limit and block list do not read as connected clients. -->
    <PreferenceCategory
        android:key="yrrp_hotspot_controls"
        android:title="@string/yrrp_hotspot_controls_title"
        settings:searchable="false">

        <com.android.settingslib.widget.SliderPreference
            android:key="yrrp_hotspot_max_clients"
            android:title="@string/yrrp_hotspot_max_clients_title"
            android:persistent="false"
            settings:keywords="@string/yrrp_hotspot_max_clients_keywords"
            settings:controller="com.android.settings.yrrp.YrrpHotspotMaxClientsPreferenceController"/>

        <Preference
            android:key="yrrp_hotspot_blocked_entry"
            android:title="@string/yrrp_hotspot_blocked_title"
            android:summary="@string/summary_placeholder"
            android:fragment="com.android.settings.yrrp.YrrpHotspotBlockedSettings"
            settings:keywords="@string/yrrp_hotspot_blocked_keywords"
            settings:controller="com.android.settings.yrrp.YrrpHotspotBlockedEntryPreferenceController"/>
    </PreferenceCategory>
</PreferenceScreen>
