<!-- A checkerboard under the fill so translucency shows. The fill color is the chosen color and
     opacity, set at runtime on the yrrp_swatch_fill layer; its stroke keeps the outline visible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/transparency_tileable"/>
    <item android:id="@+id/yrrp_swatch_fill">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <stroke
                android:width="1dp"
                android:color="?android:attr/textColorSecondary"/>
        </shape>
    </item>
</layer-list>
